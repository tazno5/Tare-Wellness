# ============================================================
# Tare Wellness — Environment Variables
# ============================================================
# Copy this file to `.env` (development) or `.env.production`
# (production) and fill in the values.
#
# NEVER commit the real `.env` file to version control.
# ============================================================

# ------------------------------------------------------------
# Database (REQUIRED)
# ------------------------------------------------------------
# Development: SQLite file (default, works out of the box)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Production: PostgreSQL connection string
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
#
# DIRECT_URL is required when DATABASE_URL points at a pooled connection
# (Supabase, Neon, Render serverless). It's a direct (non-pooled)
# connection that Prisma uses for migrations.
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
#
# --- Supabase setup ---
# 1. Create a project at https://supabase.com
# 2. Dashboard → Connect → ORMs → Prisma → copy the pooled URL (port 6543)
# 3. Append ?pgbouncer=true&connection_limit=1 to DATABASE_URL
# 4. For DIRECT_URL, swap the hostname (remove -pooler) and use port 5432
#
# Example Supabase env:
# DATABASE_URL=postgresql://postgres.abc:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.abc:PASSWORD@aws-0-eu-central-1.supabase.com:5432/postgres
#
# --- Migration workflow ---
# 1. Copy the PostgreSQL schema variant over the default:
#        cp prisma/schema.postgres.prisma prisma/schema.prisma
# 2. Set DATABASE_URL (and DIRECT_URL if pooled) in .env
# 3. Create and apply the migration:
#        npx prisma migrate dev --name init
# 4. Seed the database:
#        npx prisma db seed

# ------------------------------------------------------------
# NextAuth (REQUIRED for production)
# ------------------------------------------------------------
# Secret used to sign JWT session tokens. Generate with:
#   openssl rand -base64 32
# CRITICAL: never reuse the dev fallback in production.
NEXTAUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# Public URL of the deployment. Must match exactly what users see
# in their browser (including https://). Used by NextAuth for
# callback URLs and cookie domain.
# Production: https://tarewellness.com
# Dev: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------
# Email Provider (OPTIONAL in dev, REQUIRED for production)
# ------------------------------------------------------------
# The /api/email/send route uses Gmail SMTP (via nodemailer).
#
# Setup:
# 1. Enable 2-Step Verification on your Google account:
#    https://myaccount.google.com/security
# 2. Generate an App Password at:
#    https://myaccount.google.com/apppasswords
#    App name: "Tare Wellness Email"
#    Copy the 16-character password (remove spaces).
# 3. Set GMAIL_USER to your Gmail address (must match the account
#    that generated the App Password).
# 4. Set GMAIL_APP_PASSWORD to the 16-character App Password.
# 5. Optional: set EMAIL_FROM to override the sender display name
#    and address. Format: "Display Name <email@domain.com>"
#    Defaults to "Tare Wellness <${GMAIL_USER}>".
#
# If GMAIL_USER/GMAIL_APP_PASSWORD are not set, emails are logged
# to console instead of being sent — useful for local dev.
#
# LIMITS:
# - 500 emails/day (Gmail free tier)
# - "From" address will be your @gmail.com address (not a custom
#   domain). For production, migrate to Brevo/Resend with a
#   verified custom domain.
# GMAIL_USER=your.email@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# EMAIL_FROM=Tare Wellness <your.email@gmail.com>

# ------------------------------------------------------------
# Rate Limiting (OPTIONAL in dev, recommended for production)
# ------------------------------------------------------------
# Uses Upstash Redis (https://upstash.com) for serverless rate limiting.
# Free tier: 10,000 requests/day.
# If not set, rate limiting is skipped (dev environments).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

# ------------------------------------------------------------
# Node Environment (set automatically by hosting platform)
# ------------------------------------------------------------
# NODE_ENV=production
